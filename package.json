{
  "name": "aember-arena",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e:capture": "node e2e/capture.mjs --out e2e/shots/current",
    "e2e:capture:3d": "node e2e/capture.mjs --view 3d --out e2e/shots/current-3d",
    "e2e:floor": "node e2e/capture.mjs --floor-only",
    "e2e:floor:3d": "node e2e/capture.mjs --floor-only --view 3d",
    "e2e:smoke": "node e2e/capture.mjs --match-smoke --out e2e/shots/match-smoke",
    "e2e:smoke:3d": "node e2e/capture.mjs --match-smoke --view 3d --out e2e/shots/match-smoke-3d",
    "e2e:record": "node e2e/record-session.mjs",
    "e2e:record:3d": "node e2e/record-session.mjs --view 3d --animations",
    "e2e:fit": "node e2e/fit.mjs",
    "e2e:fit:3d": "node e2e/fit.mjs --view 3d",
    "e2e:arena": "node e2e/probes/_3d-arena.mjs",
    "e2e:bundle": "node e2e/bundle-size.mjs",
    "e2e:acceptance": "node e2e/acceptance.mjs",
    "test": "vitest run",
    "gen:schema": "node scripts/gen-dsl-schema.mjs",
    "harvest": "vite-node scripts/ability-harvest.mjs --",
    "llm-relay": "node scripts/llm-cors-relay.mjs",
    "harvest:cards": "vite-node scripts/catalog-export.mjs --"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.7"
  }
}
