{
  "name": "aember-arena",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e:capture": "node e2e/capture.mjs --out e2e/shots/current",
    "e2e:floor": "node e2e/capture.mjs --floor-only",
    "e2e:smoke": "node e2e/capture.mjs --match-smoke --out e2e/shots/match-smoke",
    "e2e:record": "node e2e/record-session.mjs",
    "e2e:bundle": "node e2e/bundle-size.mjs",
    "e2e:acceptance": "node e2e/acceptance.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.7"
  }
}
