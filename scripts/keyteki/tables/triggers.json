  "onCardPlayed": { "on": "play", "subject": "event.card", "status": "ok" },
  "onCardDestroyed": { "on": "destroyed", "subject": "event.card", "status": "ok" },
  "onForgeKey": { "on": "forge", "subject": "event.player", "player": true, "status": "ok" },
