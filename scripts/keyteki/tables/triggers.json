  "onRoundEnded": { "on": "endOfTurn", "turn": true, "status": "ok" },
  "onCardDiscarded": { "on": "discard", "subject": "event.card", "status": "pending" },
  "onCardReadied": { "on": "ready", "subject": "event.card", "status": "pending" },
  "onChooseActiveHouse": { "on": "house", "status": "pending" },
  "onCardLeavesPlay": { "status": "pending" },
  "onUseCard": { "status": "pending" },
  "onDamageDealt": { "status": "pending" },
  "onDamageApplied": { "status": "pending" },
  "onCardEntersPlay": { "on": "enter", "subject": "event.card", "status": "pending" },
  "onTurnEnd": { "status": "pending" },
